# Auto-generated by omnia.image_builder.repo_mirror
# Upstream repos for package download/sync
{% for repo in upstream_repos %}

[upstream-{{ repo.name }}]
name=upstream-{{ repo.name }}
baseurl={{ repo.base_url }}
enabled=1
gpgcheck={{ '1' if (repo.gpg is defined and repo.gpg | length > 1) else '0' }}
{% if repo.gpg is defined and repo.gpg | length > 1 %}
gpgkey={{ repo.gpg }}
{% endif %}
sslverify={{ repo.sslverify | default('1') }}
{% endfor %}
