# Boot parameters for OpenCHAMI boot-service / BSS
# Generated by omnia.open_image_builder
#
# Register with: ochami bss boot params set -f yaml -d @{{ _bp_image_name }}-boot-params.yaml
# Or (legacy):   ochami-cli bss --add-bootparams --payload {{ _bp_image_name }}-boot-params.yaml
#
# Image: {{ _bp_image_name }}
# Channel: {{ openchami_channel }}
# Built: {{ ansible_date_time.iso8601 | default('unknown') }}
---
{% if openchami_node_macs | length > 0 %}
macs:
{% for mac in openchami_node_macs %}
  - "{{ mac }}"
{% endfor %}
{% else %}
# TODO: Add MAC addresses for nodes that should boot this image.
# Query SMD for node inventory:
#   ochami smd component list --type Node --role Compute
# Or provide macs directly:
macs:
  - "REPLACE_WITH_NODE_MAC"
{% endif %}
kernel: "{{ _bp_kernel_url }}"
initrd: "{{ _bp_initrd_url }}"
params: "{{ _bp_params | trim }}"
