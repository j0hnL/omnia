#!/bin/bash
# Register boot parameters with OpenCHAMI boot-service
# Generated by omnia.open_image_builder
#
# Image: {{ _bp_image_name }}
# Channel: {{ openchami_channel }}

set -euo pipefail

BOOT_PARAMS="{{ output_dir }}/{{ _bp_image_name }}/{{ _bp_image_name }}-boot-params.yaml"

echo "Registering boot parameters from: $BOOT_PARAMS"
echo "  Kernel:  {{ _bp_kernel_url }}"
echo "  Initrd:  {{ _bp_initrd_url }}"
echo "  Channel: {{ openchami_channel }}"
{% if openchami_node_macs | length > 0 %}
echo "  Nodes:   {{ openchami_node_macs | length }} MACs"
{% else %}
echo "  WARNING: No MAC addresses configured. Edit $BOOT_PARAMS first."
exit 1
{% endif %}

# Try modern ochami CLI first, fall back to legacy
if command -v ochami >/dev/null 2>&1; then
    ochami boot config add --payload "$BOOT_PARAMS"
elif command -v ochami-cli >/dev/null 2>&1; then
    ochami-cli bss --add-bootparams --payload "$BOOT_PARAMS"
else
    echo "ERROR: Neither ochami nor ochami-cli found in PATH"
    echo "Install from: https://github.com/OpenCHAMI/ochami"
    echo "Or register manually:"
    echo "  curl -X POST <boot-service-url>/bootparameters -d @$BOOT_PARAMS"
    exit 1
fi

echo "Boot parameters registered successfully."
