# Auto-generated by omnia.image_builder
# RPM repositories for image building
{% for repo in _repos %}
{% if repo.base_url is defined and repo.base_url | default('') | length > 1 %}

[build-{{ repo.name }}]
name=build-{{ repo.name }}
baseurl={{ repo.base_url }}
enabled=1
gpgcheck={{ '1' if (repo.gpg is defined and repo.gpg | default('') | length > 1) else '0' }}
{% if repo.gpg is defined and repo.gpg | default('') | length > 1 %}
gpgkey={{ repo.gpg }}
{% endif %}
{% if repo.sslclientcert is defined and repo.sslclientcert | default('') | length > 0 %}
sslclientcert={{ repo.sslclientcert }}
{% endif %}
{% if repo.sslclientkey is defined and repo.sslclientkey | default('') | length > 0 %}
sslclientkey={{ repo.sslclientkey }}
{% endif %}
{% if repo.sslcacert is defined and repo.sslcacert | default('') | length > 0 %}
sslcacert={{ repo.sslcacert }}
{% endif %}
sslverify={{ repo.sslverify | default('1') }}
{% endif %}
{% endfor %}
