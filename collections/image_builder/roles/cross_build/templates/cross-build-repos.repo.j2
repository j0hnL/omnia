# Auto-generated by omnia.image_builder.cross_build
# aarch64 Pulp repository configuration for cross-building
#
# These repos are used by native x86_64 dnf with --forcearch=aarch64
# to install aarch64 packages into the installroot.
{% for repo in rhel_repos %}
{% if repo.base_url is defined and repo.base_url | length > 1 %}

[aarch64-{{ repo.name }}]
name=aarch64-{{ repo.name }}
baseurl={{ repo.base_url }}
enabled=1
gpgcheck={{ '1' if (repo.gpg is defined and repo.gpg | length > 1) else '0' }}
{% if repo.gpg is defined and repo.gpg | length > 1 %}
gpgkey={{ repo.gpg }}
{% endif %}
sslverify={{ repo.sslverify | default('1') }}
{% endif %}
{% endfor %}
