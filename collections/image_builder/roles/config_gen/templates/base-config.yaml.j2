# Auto-generated by omnia.image_builder config_gen role
# image-thrillhouse config for: {{ _base_image_name }}
#
# Build with:
#   image-thrillhouse build --config {{ _config_path }}
---
meta:
  name: '{{ _base_image_name }}'
  tags:
    - '{{ os_version }}'
  from: scratch

layer:
  manager:
    name: '{{ _pkg_manager }}'
{% if _pkg_manager == 'dnf' %}
    options:
      releasever: '{{ os_version.split(".")[0] }}'
    config: |
      [main]
      gpgcheck={{ '1' if gpg_check | default(true) | bool else '0' }}
      install_weak_deps=False
      tsflags=nodocs
      reposdir=/etc/image-thrillhouse/yum.repos.d
{% elif _pkg_manager == 'mmdebstrap' %}
    options:
      suite: '{{ os_version_codename | default(_deb_codename) }}'
      variant: minbase
{% endif %}
  repos:
{% if _pkg_manager == 'dnf' %}
{% for repo in _repos %}
{% if repo.base_url | default('') | length > 0 %}
    - path: /etc/image-thrillhouse/yum.repos.d/{{ repo.name }}.repo
      content: |
        [{{ repo.name }}]
        name={{ repo.name }}
        baseurl={{ repo.base_url }}
        enabled=1
{% if repo.gpg | default('') | length > 0 %}
        gpgcheck=1
        gpgkey={{ repo.gpg }}
{% else %}
        gpgcheck=0
{% endif %}
{% if repo.sslclientcert is defined and repo.sslclientcert | default('') | length > 0 %}
        sslclientcert={{ repo.sslclientcert }}
{% endif %}
{% if repo.sslclientkey is defined and repo.sslclientkey | default('') | length > 0 %}
        sslclientkey={{ repo.sslclientkey }}
{% endif %}
{% if repo.sslcacert is defined and repo.sslcacert | default('') | length > 0 %}
        sslcacert={{ repo.sslcacert }}
{% endif %}
{% endif %}
{% endfor %}
{% elif _pkg_manager == 'mmdebstrap' %}
{% for repo in _repos %}
    - path: /etc/apt/sources.list.d/{{ repo.name }}.list
      content: |
        deb {{ repo.base_url }} {{ os_version_codename | default(_deb_codename) }} {{ repo.components | default('main') }}
{% endfor %}
{% if _repos | length == 0 %}
    - path: /etc/apt/sources.list.d/default.list
      content: |
        deb {{ _deb_default_mirror }} {{ _deb_codename }} main universe
{% endif %}
{% endif %}
  actions:
    install:
      packages:
{% if _pkg_manager == 'dnf' %}
{% for grp in (package_groups if package_groups | default([]) | length > 0 else _default_package_groups) %}
        - '@{{ grp }}'
{% endfor %}
{% elif _pkg_manager == 'mmdebstrap' %}
        - '{{ _deb_kernel_pkg }}'
        - 'live-boot'
        - 'initramfs-tools'
        - 'systemd-sysv'
{% endif %}
{% for pkg in _packages %}
        - '{{ pkg }}'
{% endfor %}
{% if _post_install_cmds | default([]) | length > 0 %}
    run:
{% for cmd in _post_install_cmds %}
      - '{{ cmd }}'
{% endfor %}
{% endif %}

publish:
  - type: local
{% if output_dir | default('') | length > 0 %}
  - type: squashfs
    path: '{{ output_dir }}/base'
{% endif %}
{% if registry_url | default('') | length > 0 %}
  - type: registry
    url: '{{ registry_url }}/{{ registry_ns }}'
    tls_verify: {{ registry_tls_verify | default(true) | lower }}
{% endif %}
{% if publish_s3 | default(false) | bool and s3_endpoint | default('') | length > 0 %}
  - type: s3
    endpoint: '{{ s3_endpoint }}'
    bucket: '{{ s3_bucket | default("boot-images") }}'
    prefix: 'base/{{ _base_image_name }}/'
    access_key: '{{ s3_access_id }}'
    secret_key: '{{ s3_secret_key }}'
{% endif %}
